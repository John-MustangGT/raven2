#!/bin/bash
# prerm script for raven

set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop the service so dpkg can replace the binary
        if systemctl is-active --quiet raven.service; then
            systemctl stop raven.service
        fi

        # Only deregister the service on an actual removal - postinst
        # re-enables it on every install/upgrade anyway, but an upgrade
        # or deconfigure shouldn't leave it disabled even transiently.
        if [ "$1" = "remove" ] && systemctl is-enabled --quiet raven.service; then
            systemctl disable raven.service
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
